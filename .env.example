# Objectflix environment variables
# Copy to .env and fill in values. Comma-separated for multiple keys per provider.

# AI providers (client-side, loaded via gen-env.js → src/env.js)
GEMINI_API_KEY=
GROQ_API_KEY=
PROJECT_ARES_API_KEY=
CALLMISSED_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Anti-Reversing Gate (ARG) unlock secret
ARG_SECRET=
