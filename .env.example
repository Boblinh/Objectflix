# Objectflix environment variables
# Copy to .env and fill in values. Comma-separated for multiple keys per provider.

# AI providers (client-side, loaded via gen-env.js → src/env.js)
GEMINI_API_KEY=
GROQ_API_KEY=
PROJECT_ARES_API_KEY=
CALLMISSED_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Public API URL (set to http://localhost:8787 for local Worker development)
OBJECTFLIX_API_BASE_URL=
# Set to azure to prefer the Worker-hosted Azure Responses provider.
OBJECTFLIX_AI_PROVIDER=

# Public OAuth client IDs only. Client secrets belong in worker/.dev.vars.
DISCORD_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Never put STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET in frontend configuration.

# Anti-Reversing Gate (ARG) unlock secret
ARG_SECRET=
