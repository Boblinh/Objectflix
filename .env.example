# Copy this file to .env and fill in real values, then run:  node scripts/gen-env.js
# .env is gitignored — never commit it.

# Google Gemini API key (used by the on-page assistant).
GEMINI_API_KEY=

# Discord OAuth application. clientId is public; clientSecret must match the
# app's OAuth2 secret exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Header secret used by the Objectflix ARG gate. This is sent by the browser,
# so it is public by design (not a real credential) — kept here for consistency.
ARG_SECRET=
